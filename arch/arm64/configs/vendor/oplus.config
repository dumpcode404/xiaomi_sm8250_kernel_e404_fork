# OPLUS Port ROM build fragment (branch stable-beta-oplus).
# Usage: make O=out vendor/munch_defconfig vendor/oplus.config
#
# CONFIG_OPLUS_PORT is the single build-time switch of drivers/oplus (all bool, built into Image,
# no modules): it enables the OPLUS drivers/stubs/nandswap/nwpower and the SELinux status spoof,
# so it must NOT be set in the standard munch_defconfig. The zip of this build carries the
# OPLUS_BUILD marker for AnyKernel3 (dumpcode404/AnyKernel3, branch oplus).
CONFIG_OPLUS_PORT=y
