# OPLUS Port ROM build fragment (branch stable-beta-oplus).
# Usage: make O=out vendor/munch_defconfig vendor/oplus.config
#
# merge_config.sh treats every comment line that starts with a hash, a space and
# a CONFIG symbol as a symbol line, so never start a comment line that way here.
#
# OPLUS_PORT is the single build-time switch of drivers/oplus (all bool, built
# into Image, no modules): it enables the OPLUS drivers and the SELinux status
# spoof, so it must NOT be set in the standard munch_defconfig. The other two
# symbols are listed explicitly because the base defconfig may already have
# recorded them as disabled. The zip of this build carries the OPLUS_BUILD
# marker for AnyKernel3 (dumpcode404/AnyKernel3, branch oplus).
CONFIG_OPLUS_PORT=y
CONFIG_OPLUS_OPROJECT=y
CONFIG_OPLUS_STUB_NODES=y
