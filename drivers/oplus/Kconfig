config OPLUS_PORT
	bool "oplus port"
	default n
	help
	 This will allow all OPLUS Feature to be build

config OPLUS_OPROJECT
	bool "oplus project"
	default y if OPLUS_PORT
	help
	 define this config to define oplus project
	  
config OPLUS_STUB_NODES
	bool "oplus missing nodes stubs"
	depends on OPLUS_PORT
	default y
	help
	 Select this to enable dummy stubs for missing oplus procfs and sysfs nodes
